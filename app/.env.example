EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# PayMongo backend (Node) — base URL where /payments/appointments/* endpoints live.
# Production (works from phone on Wi‑Fi/cellular):
EXPO_PUBLIC_PAYMENT_API_URL=https://batasmo-web.onrender.com
EXPO_PUBLIC_BATASMO_WEB_API_URL=https://batasmo-web.onrender.com
# Optional dev fallback when Render free tier is sleeping (same Wi‑Fi, Web/backend on :4000):
# EXPO_PUBLIC_PAYMENT_LAN_FALLBACK_URL=http://192.168.1.10:4000
# Optional Edge fallback (only if deployed): EXPO_PUBLIC_NOTARIAL_PAYMENT_USE_EDGE=1
# Local: run your reference Web/backend on port 4000, then use your PC LAN IP (not 127.0.0.1 on a physical device):
# EXPO_PUBLIC_PAYMENT_API_URL=http://192.168.1.10:4000

# Video calls (VideoSDK): GET /videosdk-token, POST /videosdk-create-room on your Node API.
EXPO_PUBLIC_BATASMO_WEB_API_URL=https://batasmo-web.onrender.com

# Attorney roster photos (`/assets/attorneys/*`). Defaults to https://batasmo-web.vercel.app when unset.
# EXPO_PUBLIC_WEB_PUBLIC_URL=https://batasmo-web.vercel.app

# Didit — free Workflow (keys on faceid-server only)
# Same Wi-Fi dev: leave unset (uses PC LAN :4001). Remote tester: ngrok port 4001, e.g.:
# EXPO_PUBLIC_DIDIT_PROXY_URL=https://xxxx.ngrok-free.app
# Production APK: https://batasmo-web.onrender.com (after /didit deployed)

# FaceID MegLive (optional): merge `faceid-server/` routes into your API or run standalone.
# Requires native module `BatasMoMegLive` — see services/megLiveBridge.js
# EXPO_PUBLIC_FACEID_LIVENESS_ENABLED=true
# EXPO_PUBLIC_FACEID_ALLOW_LEGACY_FALLBACK=true
# EXPO_PUBLIC_FACEID_SHARED_SECRET=match FACEID_MOBILE_SHARED_SECRET on the server
# Local: use your PC LAN IP on device (e.g. http://192.168.1.10:4000), not only localhost.
EXPO_PUBLIC_VIDEOSDK_API_BASE_URL=http://127.0.0.1:4000

# Optional: chatbot screen only (can match VIDEOSDK host if one server serves both)
# EXPO_PUBLIC_CHATBOT_API_URL=http://127.0.0.1:4000

# Local/dev only: bypass server login lockout RPC (remove before production release)
# EXPO_PUBLIC_SKIP_LOGIN_LOCKOUT=1

# Show Supabase raw auth error text in the login alert (debugging only)
# EXPO_PUBLIC_AUTH_DEBUG=1
