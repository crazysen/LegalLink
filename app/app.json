{
  "expo": {
    "name": "BatasMoApp",
    "slug": "BatasMoApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#04070B",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#04070B"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "batasmoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.batasmo.app"
    },
    "android": {
      "package": "com.batasmo.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@videosdk.live/expo-config-plugin",
        {
          "cameraPermission": "Allow BatasMo to use your camera for video consultations.",
          "microphonePermission": "Allow BatasMo to use your microphone for video consultations."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}
