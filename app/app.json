{
  "expo": {
    "name": "LegalLink",
    "slug": "legallink",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "backgroundColor": "#04070B",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#04070B"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "legallinkapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legallink.app"
    },
    "android": {
      "package": "com.legallink.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LegalLink to use your camera for identity verification and video consultations.",
          "microphonePermission": "Allow LegalLink to use your microphone for identity verification and video consultations.",
          "recordAudioAndroid": true
        }
      ],
      [
        "@videosdk.live/expo-config-plugin",
        {
          "cameraPermission": "Allow LegalLink to use your camera for video consultations.",
          "microphonePermission": "Allow LegalLink to use your microphone for video consultations."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "1436cc79-6e3f-4863-a652-f442d4b78d54"
      }
    }
  }
}
