PORT=4001

# FaceID console API key (Megvii FaceID product — may differ from Face++ Open Platform keys).
FACEID_API_KEY=
FACEID_API_SECRET=

# Optional: overseas / regional API host if your contract uses one (default China global endpoint).
# FACEID_API_BASE=https://api.megvii.com

# Optional: require Authorization: Bearer <token> from the app (set same value in Expo EXPO_PUBLIC_FACEID_SHARED_SECRET).
# FACEID_MOBILE_SHARED_SECRET=

# --- Render (production / APK / remote testers) ---
# Deploy Mobile/faceid-server as a Render Web Service, then in Mobile/app/.env:
# EXPO_PUBLIC_DIDIT_PROXY_URL=https://YOUR-SERVICE.onrender.com
# Set the same keys below in Render → Environment (not in the mobile app).

# Didit — FREE tier uses Workflow (500 checks/mo per feature), not Standalone APIs.
# 1. business.didit.me → Workflows → Create "Core KYC" (ID + passive liveness + face match)
# 2. Copy Workflow ID below. Standalone /verify-document needs prepaid credits; /didit/session uses free tier.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=batasmoapp://didit-callback

# Legacy Face++ (optional — app no longer uses this)
# FACEPLUS_API_KEY=
# FACEPLUS_API_SECRET=

# Liveness: meglive (action / blink-style), still, flash — see Megvii docs.
# FACEID_LIVENESS_TYPE=meglive

# Optional Megvii tuning (see get_biz_token docs).
# FACEID_VERBOSE=1
# FACEID_SECURITY_LEVEL=2
